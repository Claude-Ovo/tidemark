# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 里，绝不提交。
# 本文件(.env.example)是会被提交到GitHub的模板，只放占位符，绝不放真实密码！
# CockroachDB Cloud 控制台 -> Connect -> Connection string 整串贴进来
COCKROACH_DATABASE_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full

# 之后 AWS 配好再填
AWS_REGION=us-east-1

# HMAC key for tool_requests payload fingerprints (required in non-dev).
# For local development only, you may instead set TIDEMARK_DEV_INSECURE=1.
TIDEMARK_HMAC_KEY=
TIDEMARK_ADMIN_KEY=   # P0-08 admin surface (forget). Empty = admin routes disabled unless TIDEMARK_DEV_INSECURE=1

# --- Production (Lambda) only: none of these belong in a local .env ---
# TIDEMARK_SECRET_ARN     set on the functions by infra/deploy.ps1; secrets.mjs pulls
#                         COCKROACH_DATABASE_URL / TIDEMARK_HMAC_KEY / TIDEMARK_ADMIN_KEY /
#                         TIDEMARK_AGENT_KEYS from Secrets Manager at cold start (allowlisted,
#                         fail-closed, env vars take precedence).
# TIDEMARK_AGENT_KEYS     JSON {api_key: {tenant_id, agent_id, capabilities[]}}. When present it
#                         REPLACES the built-in dev key table entirely.
# TIDEMARK_DATABASE       tidemark_prod on Lambda; defaults to tidemark_dev locally.
# TIDEMARK_POOL_MAX       1 on Lambda (per execution environment); 10 for the local single-process server.
# TIDEMARK_NIGHTLY_TENANTS comma-separated tenants for the nightly function (default demo-tenant).
# EMBED_PROVIDER          local-onnx (default; sealed in-process MiniLM) | stub (tests) | bedrock
#                         (enterprise accounts only, unverified on this one - conclusion 55).
# DREAM_PROVIDER          stub (deterministic extraction, the v1 final form) | bedrock (not wired).
# TIDEMARK_MODEL_DIR      override the sealed model directory (tests use it for fail-closed cases).
